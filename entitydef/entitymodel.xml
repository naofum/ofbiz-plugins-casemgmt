<entitymodel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/entitymodel.xsd">
    <title>Case Management Entity Model</title>
    <description>
        Generic case management kernel. Case is a 1:1 extension of a WorkEffort
        with workEffortTypeId=CASE. Human tasks use child WorkEfforts with
        workEffortTypeId=CASE_ASSIGNMENT.
    </description>
    <version>1.0</version>

    <!-- ========================================================= -->
    <!-- Metadata                                                  -->
    <!-- ========================================================= -->

    <entity entity-name="CaseType" package-name="org.apache.ofbiz.casemgmt.case"
            title="Case Type">
        <field name="caseTypeId" type="id"></field>
        <field name="parentCaseTypeId" type="id"></field>
        <field name="caseTypeName" type="name"></field>
        <field name="description" type="description"></field>
        <field name="primaryEntityName" type="name"></field>
        <field name="extensionEntityName" type="name"></field>
        <field name="extensionFormId" type="id-long"></field>
        <field name="definitionVersion" type="numeric"></field>
        <field name="activeDefinitionVersion" type="numeric"></field>
        <field name="statusId" type="id"></field>
        <field name="defaultSlaId" type="id"></field>
        <field name="accessPolicyId" type="id"></field>
        <field name="createdDate" type="date-time"></field>
        <field name="lastModifiedDate" type="date-time"></field>
        <prim-key field="caseTypeId"/>
        <relation type="one" fk-name="CASE_TYPE_PARENT" rel-entity-name="CaseType">
            <key-map field-name="parentCaseTypeId" rel-field-name="caseTypeId"/>
        </relation>
        <relation type="one" fk-name="CASE_TYPE_STATUS" rel-entity-name="StatusItem">
            <key-map field-name="statusId" rel-field-name="statusId"/>
        </relation>
        <index name="CASE_TYPE_STATUS_IDX">
            <index-field name="statusId"/>
        </index>
    </entity>

